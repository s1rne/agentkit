{
  "name": "@s1rne/agentkit",
  "version": "0.5.2",
  "description": "A team of AI agents, project memory and engineering process — deployed into any repository with one command. Claude Code, Cursor, AGENTS.md.",
  "keywords": [
    "ai-agents",
    "agent-team",
    "claude-code",
    "cursor",
    "codex",
    "agents-md",
    "context-engineering",
    "ai-workflow",
    "subagents",
    "developer-tools",
    "scaffolding"
  ],
  "author": "s1rne <s.simaranov8@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/s1rne/agentkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s1rne/agentkit.git"
  },
  "bugs": {
    "url": "https://github.com/s1rne/agentkit/issues"
  },
  "type": "module",
  "bin": {
    "agentkit": "bin/agentkit.mjs",
    "agent-kit": "bin/agentkit.mjs"
  },
  "exports": {
    "./bin/agentkit.mjs": "./bin/agentkit.mjs",
    "./package.json": "./package.json"
  },
  "files": [
